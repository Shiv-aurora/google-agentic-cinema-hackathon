CLAPPY_DATA_DIR=data
CLAPPY_GOOGLE_PROJECT=clappy-cinema-2026-0907
CLAPPY_GOOGLE_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
CLAPPY_GEMINI_MODEL=gemini-2.5-flash
# Hosted live-shot policy uses the lower-latency Google model; edits keep Flash.
CLAPPY_DIRECTOR_LIVE_MODEL=gemini-2.5-flash-lite
# Local only. Omit on deployment to use service-account ADC.
CLAPPY_AUTH_MODE=gcloud
CLAPPY_LIVE_MODEL=
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=clappy
CLICKHOUSE_PASSWORD=clappy-local-only
CLICKHOUSE_DATABASE=clappy
CLICKHOUSE_SECURE=false
# Required before public API admission. Use a randomly generated 32+ character
# secret, never a VITE_ variable or a committed value. Blank leaves local entry open.
CLAPPY_DEMO_ACCESS_KEY=
# Set the exact HTTPS site origin when hosted; a public origin requires an invite.
CLAPPY_PUBLIC_ORIGIN=
# UTC-day operation caps persist in data/usage.sqlite. Not a dollar spending cap.
CLAPPY_DAILY_SESSIONS=100
CLAPPY_DAILY_TAKES=60
CLAPPY_DAILY_AI_JOBS=200
CLAPPY_DAILY_SPEECH_SECONDS=3600
CLAPPY_DAILY_VOICE_REQUESTS=100
CLAPPY_DAILY_RENDERS=100
# Private server-only key created by scripts.configure_media_auth. Never VITE_.
CLAPPY_MEDIA_ADMIN_KEY_PATH=data/media-admin.key
