[Unit]
Description=Clappy production coordinator
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=clappy
Group=clappy
WorkingDirectory=/opt/clappy
EnvironmentFile=/etc/clappy.env
Environment=CLAPPY_DIRECTOR_LIVE_MODEL=gemini-2.5-flash-lite
ExecStart=/opt/clappy/.venv/bin/uvicorn services.api.main:app --host 127.0.0.1 --port 8000 --no-access-log --limit-concurrency 80 --timeout-keep-alive 5 --ws-max-size 65536
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/clappy/data
MemoryMax=8G
TasksMax=512
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
