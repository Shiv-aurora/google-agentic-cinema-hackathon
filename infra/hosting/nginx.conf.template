# Render __CLAPPY_HOST__ with the validated public hostname before installation.
limit_req_zone $binary_remote_addr zone=clappy_requests:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=clappy_connections:10m;
map $http_upgrade $clappy_connection { default upgrade; '' close; }
server {
    listen 80;
    server_name __CLAPPY_HOST__;
    server_tokens off;
    access_log off;
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 30s;
    limit_req zone=clappy_requests burst=100 nodelay;
    limit_req_status 429;
    limit_conn clappy_connections 32;
    limit_conn_status 429;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;
    root /opt/clappy/dist;
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $clappy_connection;
        proxy_read_timeout 180s;
        proxy_buffering off;
    }
    location /stream/ {
        proxy_pass http://127.0.0.1:8889/;
        proxy_http_version 1.1;
        proxy_redirect ~^(/.*)$ /stream$1;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
    location ~ /\. { deny all; }
    location / { try_files $uri $uri/ /index.html; }
}
